/* erwin Builtin Trigger */
/* DELETE trigger on tbl_product */
BEGIN
  DECLARE  @errno   int,
           @severity int,
           @state    int,
           @errmsg  varchar(255)
    /* erwin Builtin Trigger */
    /* tbl_cust  tbl_product on child delete no action */
    /* ERWIN_RELATION:CHECKSUM="000141fe", PARENT_OWNER="", PARENT_TABLE="tbl_cust"
    CHILD_OWNER="", CHILD_TABLE="tbl_product"
    P2C_VERB_PHRASE="", C2P_VERB_PHRASE="", 
    FK_CONSTRAINT="R_1", FK_COLUMNS="cust_id" */
