CREATE TRIGGER tD_customer ON tbl_cust FOR DELETE AS
/* erwin Builtin Trigger */
/* DELETE trigger on tbl_cust */
BEGIN
  DECLARE  @errno   int,
           @severity int,
           @state    int,
           @errmsg  varchar(255)
    /* erwin Builtin Trigger */
    /* tbl_cust  tbl_product on parent delete no action */
    /* ERWIN_RELATION:CHECKSUM="0001193e", PARENT_OWNER="", PARENT_TABLE="tbl_cust"
    CHILD_OWNER="", CHILD_TABLE="tbl_product"
    P2C_VERB_PHRASE="", C2P_VERB_PHRASE="", 
    FK_CONSTRAINT="R_1", FK_COLUMNS="cust_id" */
    IF EXISTS (
      SELECT * FROM deleted,tbl_product
      WHERE
        /*  %JoinFKPK(tbl_product,deleted," = "," AND") */
        tbl_product.cust_id = deleted.cust_id
    )
    BEGIN
      SELECT @errno  = 30001,
             @errmsg = 'Cannot delete tbl_cust because tbl_product exists.'
      GOTO error
    END


    /* erwin Builtin Trigger */
    RETURN
error:
   RAISERROR (@errmsg, -- Message text.
              @severity, -- Severity (0~25).
              @state) -- State (0~255).
    rollback transaction
END

